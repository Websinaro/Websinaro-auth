# ─── Required secrets — generate with: openssl rand -hex 32 ───
ACCESS_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32-aaaa
REFRESH_TOKEN_SECRET=change-me-generate-with-openssl-rand-hex-32-bbbb

# ─── App ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────
JWT_ISSUER=my-app
JWT_AUDIENCE=my-app-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
REQUIRE_EMAIL_VERIFICATION=false

# ─── Redis (optional — recommended for production) ─────────
# REDIS_URL=redis://localhost:6379

# ─── Database ──────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/myapp
