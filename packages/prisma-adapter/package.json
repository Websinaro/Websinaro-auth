{
  "name": "@websinaro/auth-prisma",
  "version": "1.0.0",
  "description": "Prisma adapter for @websinaro/auth",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0",
    "@websinaro/auth": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
