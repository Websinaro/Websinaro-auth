{
  "name": "@websinaro/auth",
  "version": "1.0.0",
  "description": "Production-grade, enterprise-quality authentication framework for Node.js",
  "keywords": [
    "auth",
    "authentication",
    "jwt",
    "sessions",
    "rbac",
    "security",
    "typescript"
  ],
  "author": "Websinaro",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.cjs",
      "types": "./dist/middleware/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs",
      "types": "./dist/adapters/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "jose": "^5.4.0",
    "argon2": "^0.40.3",
    "xss": "^1.0.15",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "typescript": "^5.4.5",
    "tsup": "^8.1.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "ioredis": "^5.3.2",
    "eslint": "^9.4.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}